      "role": "incumbent and current behavior",
      "reverse_level_order": "generation order: nearest coarser level to coarsest"
    },
    "coarsest_to_finest": {
      "role": "research-only candidate",
      "reverse_level_order": "reverse of the generated list: coarsest level to nearest coarser"
    }
  },
  "only_arm_difference": "Traversal order of the identical generated reverse-level (coarse_step, coarse_micro_steps) list.",
  "reverse_level_contract": {
    "max_error_delta": 1.0,
    "pair_generation": "Starting from the accepted forward level's step and micro_steps, repeatedly execute coarse_steps /= 2 then coarse_step *= 2.0 while coarse_steps / 2 >= min_micro_steps. Both arms store the identical resulting pairs before traversal.",
    "forbidden_generation_changes": [
      "direct powers",
      "division from the original step",
      "floating-point reassociation",
      "changed integrator",
      "changed endpoint validity predicate",
      "changed endpoint-error predicate",
      "cached or reused reverse trajectory"
    ],
    "short_circuit": [
      "The first valid reverse attempt with endpoint_error <= delta rejects the leaf as ReverseCoarserAccepted.",
      "The first invalid reverse attempt rejects the leaf through the current invalid-evaluation path.",
      "The forward leaf is retained only when every evaluated reverse attempt is valid and has endpoint_error > delta."
    ]
  },
  "semantic_qualification": {
    "qualified_statement": "For deterministic targets when all reverse attempts reached by either order are valid, accepted endpoint, leaf accepted/rejected boolean, sampler RNG, adaptation, and retained draws are order-independent because both arms evaluate the same OR over the same generated level set.",
    "qualification_limit": "A level set containing both an accepted and an invalid reverse attempt can change rejection cause and public error according to traversal order. No universal bit-identity claim is made.",
    "evidence_requirement": "Require semantic-hash equality, exact stop/rejection and public-error identity, exact forward-call identity, and no health/invalid regression independently in every paired cell."
  },
