+            Ok(candidate) => (
+                MetricUpdateOutcome::Installed,
+                Some(candidate),
+                5.0 / (n + 5.0),
+                0.0,
+                Some(hi / lo),
+                0,
+            ),
+            Err(_) => (
+                MetricUpdateOutcome::InsufficientSamples,
+                None,
+                0.0,
+                0.0,
+                None,
+                1,
+            ),
+        }
+    }
